@prefix : <http://www.semanticweb.org/tshep/ontologies/2026/7/untitled-ontology-24#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.semanticweb.org/tshep/ontologies/2026/7/untitled-ontology-24> .

<http://www.semanticweb.org/tshep/ontologies/2026/7/untitled-ontology-24> rdf:type owl:Ontology ;
                                                                          
                                                                          rdfs:label "ARTO"@en ,
                                                                                     "ARTO M1 Pilot Individuals"@en ,
                                                                                     "ARTO M1 Step 2"@en ,
                                                                                     "ARTO M1 Step 3"@en ,
                                                                                     "ARTO M1 Step 4"@en ,
                                                                                     "ARTO M1 Step 5"@en ,
                                                                                     "ARTO M2 Traceability Module"@en ,
                                                                                     "ARTO M3 Sprint Module"@en ,
                                                                                     "ARTO M4 Semantic Resolution Module"@en ,
                                                                                     "ARTO — Agile Requirements Traceability Ontology"@en ;
                                                                          
                                                                          <http://purl.org/dc/terms/created> "2026"^^xsd:gYear ;
                                                                          
                                                                          owl:versionInfo "1.0.0 — M4: TermVariant + SynonymCluster + DriftEvent + SKOS + R3" ,
                                                                                          "1.0.0 — M3: SprintBacklog + BacklogItem + metrics + bridge properties" ,
                                                                                          "1.0.0 — step 2: RT object properties + OrphanArtefact" ,
                                                                                          "1.0.0 — step 5 final: MaintenanceArtefact + Sprint + SKOS" ;
                                                                          
                                                                          rdfs:comment "ARTO M1 Artefact Module — Step 3: TestingArtefact (TestCase, TestResult), CodeCommit, and deferred RT properties (verifies, fixes, derives, supersedes, tracesTo)."@en ,
                                                                                       "ARTO M4 Semantic Resolution Module — TermVariant, SynonymCluster, DriftEvent, SKOS synonym mappings, and SWRL Rule R3 for cross-sprint semantic equivalence propagation (CQ8)."@en ,
                                                                                       "Root ontology for the ARTO network. Imports all four modules (M1 Artefact · M2 Traceability · M3 Sprint · M4 Semantic Resolution) and declares five bridge axioms connecting the modules. S1 reuse (Lapeña 2019 · Pakdeetrakulwong 2015) documented honestly as intent not executed due to OWL file unavailability. S3 ODP reuse documented at conceptual instantiation level with rdfs:isDefinedBy citations in module files."@en ;
                                                                          
                                                                          <http://purl.org/dc/elements/1.1/rights> "University of Botswana PhD Research — Tshepho Koboyatshwene 2026" ;
                                                                          
                                                                          owl:versionInfo "0.6.0 — middle-out step 1 v5: SDLC-aligned hierarchy, no UnclassifiedIssue" ,
                                                                                          "5.0.0 — M4: imports m4-semantic, TermVariant + SynonymCluster + DriftEvent individuals added" ;
                                                                          
                                                                          rdfs:comment "ARTO M1 Artefact Module — Step 4: DesignArtefact, DeploymentArtefact, Event ODP (Sprint), Part-Whole ODP formal annotation, and new RT properties (refines, realizes, fixedIn, affectedIn, containedIn)."@en ;
                                                                          
                                                                          <http://purl.org/dc/elements/1.1/creator> "Tshepho Koboyatshwene" ;
                                                                          
                                                                          <http://purl.org/dc/elements/1.1/contributor> "University of Botswana" ;
                                                                          
                                                                          <http://purl.org/dc/elements/1.1/subject> "Requirements Traceability · Agile Software Development · OWL-DL · TAWOS · NeOn · METHONTOLOGY" ;
                                                                          
                                                                          owl:versionInfo "1.0.0 — step 4: DesignArtefact + DeploymentArtefact + Event ODP + RT properties" ,
                                                                                          "1.1.0 — root corrected: fabricated IRIs removed · ODP imports removed · honest reuse documentation" ,
                                                                                          "1.0.0 — step 3: TestingArtefact + CodeCommit + deferred RT properties" ,
                                                                                          "1.0.0 — M2: TraceLink + TraceLinkType + SWRL rules" ;
                                                                          
                                                                          rdfs:comment "ARTO M1 Artefact Module — Step 2: Core RT object properties and OrphanArtefact classifier."@en ,
                                                                                       "ARTO M1 Artefact Module — Step 5 (FINAL): MaintenanceArtefact, DefectArtefact migration, full Sprint module, documents and addresses RT properties, M4 SKOS semantic resolution preview."@en ,
                                                                                       "ARTO M2 Traceability Module — TraceLink hierarchy, TraceLinkType controlled vocabulary (7 semantic clusters), SDLC link direction, and 4 SWRL rules covering CQ3, CQ4, CQ5, CQ6, CQ7, CQ8."@en ,
                                                                                       "ARTO M3 Sprint Module — SprintBacklog, BacklogItem, sprint performance metrics (velocity, throughput, sprintGoal), component data property, and sprint bridge properties."@en ;
                                                                          
                                                                          <http://purl.org/dc/elements/1.1/description> "Agile Requirements Traceability Ontology — a modular OWL-DL network for formally representing and querying traceability links across Agile software artefacts. Built on the TAWOS dataset (11 real Agile projects, 456,000+ issues). PhD research, University of Botswana, 2026."@en ;
                                                                          
                                                                          rdfs:comment "Agile Requirements Traceability Ontology. University of Botswana PhD Research. Candidate: Tshepho Koboyatshwene."@en ,
                                                                                       "Consolidated pilot individuals for smoke testing CQ1–CQ5 and CQ-D1–CQ-D4. All cross-step RT assertions declared here to avoid Protégé SPARQL import chain issues."@en .


#################################################################
#
#    Annotation properties
#
#################################################################


###  http://www.w3.org/2004/02/skos/core#closeMatch

<http://www.w3.org/2004/02/skos/core#closeMatch> rdf:type owl:AnnotationProperty .



###  http://www.w3.org/2004/02/skos/core#exactMatch

<http://www.w3.org/2004/02/skos/core#exactMatch> rdf:type owl:AnnotationProperty .





#################################################################
#
#    Object Properties
#
#################################################################


###  http://www.ub.bw/ontologies/arto#addresses

<http://www.ub.bw/ontologies/arto#addresses> rdf:type owl:AsymmetricProperty ,
                                                      owl:ObjectProperty ;
                                             
                                             rdfs:label "addresses"@en ;
                                             
                                             rdfs:comment "An AgileArtefact (typically UserStory or SprintTask) addresses a maintenance concern (SupportRequest or ProblemTicket). TAWOS: Addresses link type (44 links, Query 4). Asymmetric. Maps to Ramesh & Jarke Addresses link type."@en ;
                                             
                                             rdfs:domain <http://www.ub.bw/ontologies/arto#AgileArtefact> ;
                                             
                                             rdfs:range <http://www.ub.bw/ontologies/arto#AgileArtefact> ;
                                             
                                             rdfs:subPropertyOf <http://www.ub.bw/ontologies/arto#hasTraceLink> .



###  http://www.ub.bw/ontologies/arto#affectedIn

<http://www.ub.bw/ontologies/arto#affectedIn> rdf:type owl:AsymmetricProperty ,
                                                       owl:ObjectProperty ;
                                              
                                              rdfs:label "affected in"@en ;
                                              
                                              rdfs:comment "An AgileArtefact (typically Bug) was discovered or reported in a specific Version. TAWOS: Affected_Version junction table — Bug (140,375) · Improvement (20,227) · Task (6,867) · New Feature (5,903) · Story (2,048). Asymmetric. Highest-volume RT property in the entire TAWOS dataset. Maps from Affected_Version.Affected_Version_ID → Version.ID."@en ;
                                              
                                              rdfs:domain <http://www.ub.bw/ontologies/arto#AgileArtefact> ;
                                              
                                              rdfs:range <http://www.ub.bw/ontologies/arto#Version> ;
                                              
                                              rdfs:subPropertyOf <http://www.ub.bw/ontologies/arto#hasTraceLink> .



###  http://www.ub.bw/ontologies/arto#affectsArtefact

<http://www.ub.bw/ontologies/arto#affectsArtefact> rdf:type owl:FunctionalProperty ,
                                                            owl:ObjectProperty ;
                                                   
                                                   rdfs:label "affects artefact"@en ;
                                                   
                                                   rdfs:comment "Links a DriftEvent to the AgileArtefact whose title changed. Functional — each DriftEvent affects exactly one AgileArtefact. TAWOS: Change_Log.Issue_ID → AgileArtefact individual."@en ;
                                                   
                                                   rdfs:range <http://www.ub.bw/ontologies/arto#AgileArtefact> ;
                                                   
                                                   rdfs:domain <http://www.ub.bw/ontologies/arto#DriftEvent> .



###  http://www.ub.bw/ontologies/arto#belongsToSprint

<http://www.ub.bw/ontologies/arto#belongsToSprint> rdf:type owl:FunctionalProperty ,
                                                            owl:ObjectProperty ;
                                                   
                                                   rdfs:label "belongs to sprint"@en ;
                                                   
                                                   rdfs:comment "Links a UserStory or SprintTask to the Sprint it is assigned to. TAWOS: Issue.Sprint_ID (Int) foreign key. Functional — each artefact belongs to exactly one sprint per iteration. Core M3 bridge property enabling CQ1 sprint context queries and CQ7 sprint velocity analysis."@en ;
                                                   
                                                   rdfs:domain <http://www.ub.bw/ontologies/arto#AgileArtefact> ;
                                                   
                                                   rdfs:range <http://www.ub.bw/ontologies/arto#Sprint> ;
                                                   
                                                   rdfs:subPropertyOf <http://www.ub.bw/ontologies/arto#hasTraceLink> .



###  http://www.ub.bw/ontologies/arto#blocks

<http://www.ub.bw/ontologies/arto#blocks> rdf:type owl:AsymmetricProperty ,
                                                   owl:IrreflexiveProperty ,
                                                   owl:ObjectProperty ;
                                          
                                          rdfs:label "blocks"@en ;
                                          
                                          rdfs:comment "One artefact prevents progress on another. TAWOS: Blocks/Blockers/Blocker/Block/Blocked (18,338 links). Asymmetric and Irreflexive. Dominant in Story↔Story (4,392) and Improvement↔Improvement (962)."@en ;
                                          
                                          rdfs:domain <http://www.ub.bw/ontologies/arto#AgileArtefact> ;
                                          
                                          rdfs:range <http://www.ub.bw/ontologies/arto#AgileArtefact> ;
                                          
                                          rdfs:subPropertyOf <http://www.ub.bw/ontologies/arto#hasTraceLink> .



###  http://www.ub.bw/ontologies/arto#causes

<http://www.ub.bw/ontologies/arto#causes> rdf:type owl:AsymmetricProperty ,
                                                   owl:IrreflexiveProperty ,
                                                   owl:ObjectProperty ;
                                          
                                          rdfs:label "causes"@en ;
                                          
                                          rdfs:comment "A Bug causes or introduces another artefact. TAWOS: Cause/Caused/Regression (7,723 links). Asymmetric and Irreflexive. Domain restricted to Bug — all causation links in TAWOS originate from Bug individuals."@en ;
                                          
                                          rdfs:range <http://www.ub.bw/ontologies/arto#AgileArtefact> ;
                                          
                                          rdfs:domain <http://www.ub.bw/ontologies/arto#Bug> ;
                                          
                                          rdfs:subPropertyOf <http://www.ub.bw/ontologies/arto#hasTraceLink> .



###  http://www.ub.bw/ontologies/arto#containedIn

<http://www.ub.bw/ontologies/arto#containedIn> rdf:type owl:AsymmetricProperty ,
                                                        owl:ObjectProperty ;
                                               
                                               rdfs:label "contained in"@en ;
                                               
                                               rdfs:comment "An AgileArtefact is grouped within a Version milestone. TAWOS: Containment link in Issue_Links — Story/Improvement/Bug ↔ Milestone (55 links, Query 10). Asymmetric. Captures milestone-level planning groupings. Domain: AgileArtefact. Range: Version (versionType = Milestone)."@en ;
                                               
                                               rdfs:domain <http://www.ub.bw/ontologies/arto#AgileArtefact> ;
                                               
                                               rdfs:range <http://www.ub.bw/ontologies/arto#Version> ;
                                               
                                               rdfs:subPropertyOf <http://www.ub.bw/ontologies/arto#hasTraceLink> .



###  http://www.ub.bw/ontologies/arto#contains

<http://www.ub.bw/ontologies/arto#contains> rdf:type owl:ObjectProperty ;
                                            
                                            rdfs:label "contains"@en ;
                                            
                                            rdfs:comment "Inverse of arto:containedIn. A Version (milestone) contains one or more AgileArtefacts. Inferred by HermiT — not asserted in ETL."@en ;
                                            
                                            rdfs:range <http://www.ub.bw/ontologies/arto#AgileArtefact> ;
                                            
                                            rdfs:domain <http://www.ub.bw/ontologies/arto#Version> ;
                                            
                                            owl:inverseOf <http://www.ub.bw/ontologies/arto#containedIn> .



###  http://www.ub.bw/ontologies/arto#dependsOn

<http://www.ub.bw/ontologies/arto#dependsOn> rdf:type owl:AsymmetricProperty ,
                                                      owl:ObjectProperty ;
                                             
                                             rdfs:label "depends on"@en ;
                                             
                                             rdfs:comment "Prerequisite dependency between artefacts. TAWOS: Depends/Dependency/Depend/dependent/Required (19,526 links). Asymmetric. Dominant in Task↔Task (3,086) and Improvement↔Improvement (2,094)."@en ;
                                             
                                             rdfs:domain <http://www.ub.bw/ontologies/arto#AgileArtefact> ;
                                             
                                             rdfs:range <http://www.ub.bw/ontologies/arto#AgileArtefact> ;
                                             
                                             rdfs:subPropertyOf <http://www.ub.bw/ontologies/arto#hasTraceLink> .



###  http://www.ub.bw/ontologies/arto#derives

<http://www.ub.bw/ontologies/arto#derives> rdf:type owl:AsymmetricProperty ,
                                                    owl:IrreflexiveProperty ,
                                                    owl:ObjectProperty ;
                                           
                                           rdfs:label "derives"@en ;
                                           
                                           rdfs:comment "One artefact is derived from another through refinement or splitting. TAWOS: Derived/Issue split/Split (1,140 links). Asymmetric and Irreflexive. Maps to Ramesh & Jarke Derives link type. Common pattern: large UserStory split into smaller stories (Issue split)."@en ;
                                           
                                           rdfs:range <http://www.ub.bw/ontologies/arto#AgileArtefact> ;
                                           
                                           rdfs:domain <http://www.ub.bw/ontologies/arto#AgileArtefact> ;
                                           
                                           rdfs:subPropertyOf <http://www.ub.bw/ontologies/arto#hasTraceLink> .



###  http://www.ub.bw/ontologies/arto#documents

<http://www.ub.bw/ontologies/arto#documents> rdf:type owl:AsymmetricProperty ,
                                                      owl:ObjectProperty ;
                                             
                                             rdfs:label "documents"@en ;
                                             
                                             rdfs:comment "A Documentation artefact formally describes or explains another AgileArtefact. TAWOS: Reference/Duplicate/Relates links between Documentation and Bug/Story/Improvement (114 links, Query 13). Asymmetric. Maps to Ramesh & Jarke Documents link type."@en ;
                                             
                                             rdfs:range <http://www.ub.bw/ontologies/arto#AgileArtefact> ;
                                             
                                             rdfs:domain <http://www.ub.bw/ontologies/arto#Documentation> ;
                                             
                                             rdfs:subPropertyOf <http://www.ub.bw/ontologies/arto#hasTraceLink> .



###  http://www.ub.bw/ontologies/arto#duplicates

<http://www.ub.bw/ontologies/arto#duplicates> rdf:type owl:ObjectProperty ,
                                                       owl:SymmetricProperty ;
                                              
                                              rdfs:label "duplicates"@en ;
                                              
                                              rdfs:comment "Marks two artefacts as duplicates. TAWOS: Duplicate/Cloners (66,470 links). Symmetric and Irreflexive. Dominant in Bug↔Bug (26,388) and Suggestion↔Suggestion (13,685)."@en ;
                                              
                                              rdfs:domain <http://www.ub.bw/ontologies/arto#AgileArtefact> ;
                                              
                                              rdfs:range <http://www.ub.bw/ontologies/arto#AgileArtefact> ;
                                              
                                              rdfs:subPropertyOf <http://www.ub.bw/ontologies/arto#hasTraceLink> .



###  http://www.ub.bw/ontologies/arto#fixedIn

<http://www.ub.bw/ontologies/arto#fixedIn> rdf:type owl:AsymmetricProperty ,
                                                    owl:ObjectProperty ;
                                           
                                           rdfs:label "fixed in"@en ;
                                           
                                           rdfs:comment "An AgileArtefact (typically Bug or SprintTask) was resolved in a specific Version. TAWOS: Fix_Version junction table — Bug (94,724) · Improvement (21,447) · Task (18,227) · Story (6,949) · New Feature (6,557). Asymmetric. Highest-volume deployment RT property in TAWOS. Maps directly from Fix_Version.Fixed_Version_ID → Version.ID."@en ;
                                           
                                           rdfs:domain <http://www.ub.bw/ontologies/arto#AgileArtefact> ;
                                           
                                           rdfs:range <http://www.ub.bw/ontologies/arto#Version> ;
                                           
                                           rdfs:subPropertyOf <http://www.ub.bw/ontologies/arto#hasTraceLink> .



###  http://www.ub.bw/ontologies/arto#fixes

<http://www.ub.bw/ontologies/arto#fixes> rdf:type owl:AsymmetricProperty ,
                                                  owl:IrreflexiveProperty ,
                                                  owl:ObjectProperty ;
                                         
                                         rdfs:label "fixes"@en ;
                                         
                                         rdfs:comment "An ImplementationArtefact (SprintTask or CodeCommit) fixes a Bug. TAWOS: Fixes/Resolve (260 links). Asymmetric and Irreflexive. Connects ImplementationArtefact to DefectArtefact — closes the defect traceability loop in the RT chain."@en ;
                                         
                                         rdfs:range <http://www.ub.bw/ontologies/arto#Bug> ;
                                         
                                         rdfs:domain <http://www.ub.bw/ontologies/arto#ImplementationArtefact> ;
                                         
                                         rdfs:subPropertyOf <http://www.ub.bw/ontologies/arto#hasTraceLink> .



###  http://www.ub.bw/ontologies/arto#followsSprint

<http://www.ub.bw/ontologies/arto#followsSprint> rdf:type owl:AsymmetricProperty ,
                                                          owl:IrreflexiveProperty ,
                                                          owl:ObjectProperty ;
                                                 
                                                 rdfs:label "follows sprint"@en ;
                                                 
                                                 rdfs:comment "Links a Sprint to the Sprint that immediately preceded it within the same project. TAWOS: derived from Sprint.Start_Date ordering WHERE Project_ID = same AND Start_Date IS NOT NULL. Asymmetric and Irreflexive. Enables sprint sequence analysis and multi-sprint velocity trend queries for CQ7."@en ;
                                                 
                                                 rdfs:range <http://www.ub.bw/ontologies/arto#Sprint> ;
                                                 
                                                 rdfs:domain <http://www.ub.bw/ontologies/arto#Sprint> .



###  http://www.ub.bw/ontologies/arto#hasAffected

<http://www.ub.bw/ontologies/arto#hasAffected> rdf:type owl:ObjectProperty ;
                                               
                                               rdfs:label "has affected"@en ;
                                               
                                               rdfs:comment "Inverse of arto:affectedIn. A Version has one or more AgileArtefacts discovered in it. Inferred by HermiT — not asserted in ETL."@en ;
                                               
                                               rdfs:range <http://www.ub.bw/ontologies/arto#AgileArtefact> ;
                                               
                                               rdfs:domain <http://www.ub.bw/ontologies/arto#Version> ;
                                               
                                               owl:inverseOf <http://www.ub.bw/ontologies/arto#affectedIn> .



###  http://www.ub.bw/ontologies/arto#hasBacklog

<http://www.ub.bw/ontologies/arto#hasBacklog> rdf:type owl:FunctionalProperty ,
                                                       owl:ObjectProperty ;
                                              
                                              rdfs:label "has backlog"@en ;
                                              
                                              rdfs:comment "Links a Sprint to its SprintBacklog. Functional — each Sprint has exactly one SprintBacklog. Core M3 bridge property connecting sprint lifecycle to backlog content."@en ;
                                              
                                              rdfs:domain <http://www.ub.bw/ontologies/arto#Sprint> ;
                                              
                                              rdfs:range <http://www.ub.bw/ontologies/arto#SprintBacklog> .



###  http://www.ub.bw/ontologies/arto#hasBacklogItem

<http://www.ub.bw/ontologies/arto#hasBacklogItem> rdf:type owl:ObjectProperty ;
                                                  
                                                  rdfs:label "has backlog item"@en ;
                                                  
                                                  rdfs:comment "Links a SprintBacklog to its constituent BacklogItems. One-to-many — a backlog contains multiple items. Core M3 content property."@en ;
                                                  
                                                  rdfs:range <http://www.ub.bw/ontologies/arto#BacklogItem> ;
                                                  
                                                  rdfs:domain <http://www.ub.bw/ontologies/arto#SprintBacklog> .



###  http://www.ub.bw/ontologies/arto#hasFixFor

<http://www.ub.bw/ontologies/arto#hasFixFor> rdf:type owl:ObjectProperty ;
                                             
                                             rdfs:label "has fix for"@en ;
                                             
                                             rdfs:comment "Inverse of arto:fixedIn. A Version has a fix for one or more AgileArtefacts. Inferred by HermiT — not asserted in ETL."@en ;
                                             
                                             rdfs:range <http://www.ub.bw/ontologies/arto#AgileArtefact> ;
                                             
                                             rdfs:domain <http://www.ub.bw/ontologies/arto#Version> ;
                                             
                                             owl:inverseOf <http://www.ub.bw/ontologies/arto#fixedIn> .



###  http://www.ub.bw/ontologies/arto#hasImplementingTask

<http://www.ub.bw/ontologies/arto#hasImplementingTask> rdf:type owl:AsymmetricProperty ,
                                                                owl:ObjectProperty ;
                                                       
                                                       rdfs:label "has implementing task"@en ;
                                                       
                                                       rdfs:comment "Decomposes a UserStory into SprintTasks. TAWOS: Story→Task (702) + Story→Sub-task (207) = 909 links. Asymmetric. Core CQ1 and CQ2 property. Part of decomposition chain: Epic → UserStory → SprintTask."@en ;
                                                       
                                                       rdfs:range <http://www.ub.bw/ontologies/arto#SprintTask> ;
                                                       
                                                       rdfs:domain <http://www.ub.bw/ontologies/arto#UserStory> ;
                                                       
                                                       rdfs:subPropertyOf <http://www.ub.bw/ontologies/arto#hasTraceLink> .



###  http://www.ub.bw/ontologies/arto#hasLinkType

<http://www.ub.bw/ontologies/arto#hasLinkType> rdf:type owl:FunctionalProperty ,
                                                        owl:ObjectProperty ;
                                               
                                               rdfs:label "has link type"@en ;
                                               
                                               rdfs:comment "The semantic cluster this TraceLink belongs to. Points to one of the 7 TraceLinkType named individuals. Functional — each link belongs to exactly one semantic cluster. Core CQ7 property."@en ;
                                               
                                               rdfs:domain <http://www.ub.bw/ontologies/arto#TraceLink> ;
                                               
                                               rdfs:range <http://www.ub.bw/ontologies/arto#TraceLinkType> .



###  http://www.ub.bw/ontologies/arto#hasMember

<http://www.ub.bw/ontologies/arto#hasMember> rdf:type owl:ObjectProperty ;
                                             
                                             rdfs:label "has member"@en ;
                                             
                                             rdfs:comment "Inverse of arto:belongsToSprint. A Sprint has one or more AgileArtefact members. Inferred by HermiT — not asserted in ETL."@en ;
                                             
                                             rdfs:range <http://www.ub.bw/ontologies/arto#AgileArtefact> ;
                                             
                                             rdfs:domain <http://www.ub.bw/ontologies/arto#Sprint> ;
                                             
                                             owl:inverseOf <http://www.ub.bw/ontologies/arto#belongsToSprint> .



###  http://www.ub.bw/ontologies/arto#hasPart

<http://www.ub.bw/ontologies/arto#hasPart> rdf:type owl:AsymmetricProperty ,
                                                    owl:IrreflexiveProperty ,
                                                    owl:ObjectProperty ;
                                           
                                           rdfs:label "has part"@en ;
                                           
                                           rdfs:comment "Compositional containment — one artefact contains another. TAWOS: Part/Child-Issue/Children/Includes/Containment/Container/Incorporates (6,172 links). Asymmetric and Irreflexive. Implements Part-Whole Content ODP. Note: SubPropertyOf hasTraceLink only — SubPropertyOf relatesTo removed to avoid non-simple property chain violation in OWL-DL (relatesTo is Symmetric making any subproperty non-simple)."@en ,
                                                        "Formally instantiates Part-Whole Content ODP (S3). Source: http://ontologydesignpatterns.org/cp/owl/partof.owl. ARTO instantiation: AgileArtefact plays both Part and Whole roles — UserStory hasPart SprintTask (via hasImplementingTask), Suggestion hasPart SubSuggestion. Re-declared here with formal ODP annotation — property axioms defined in Step 2."@en ;
                                           
                                           rdfs:isDefinedBy <http://ontologydesignpatterns.org/cp/owl/partof.owl> ;
                                           
                                           rdfs:domain <http://www.ub.bw/ontologies/arto#AgileArtefact> ;
                                           
                                           rdfs:range <http://www.ub.bw/ontologies/arto#AgileArtefact> ;
                                           
                                           rdfs:subPropertyOf <http://www.ub.bw/ontologies/arto#hasTraceLink> .



###  http://www.ub.bw/ontologies/arto#hasReportedBug

<http://www.ub.bw/ontologies/arto#hasReportedBug> rdf:type owl:ObjectProperty ;
                                                  
                                                  rdfs:label "has reported bug"@en ;
                                                  
                                                  rdfs:comment "Inverse of arto:reportedIn. Inferred by HermiT — not asserted in ETL."@en ;
                                                  
                                                  rdfs:range <http://www.ub.bw/ontologies/arto#Bug> ;
                                                  
                                                  rdfs:domain <http://www.ub.bw/ontologies/arto#UserStory> ;
                                                  
                                                  owl:inverseOf <http://www.ub.bw/ontologies/arto#reportedIn> .



###  http://www.ub.bw/ontologies/arto#hasSourceArtefact

<http://www.ub.bw/ontologies/arto#hasSourceArtefact> rdf:type owl:FunctionalProperty ,
                                                              owl:ObjectProperty ;
                                                     
                                                     rdfs:label "has source artefact"@en ;
                                                     
                                                     rdfs:comment "The AgileArtefact from which this TraceLink originates. Functional — each TraceLink has exactly one source."@en ;
                                                     
                                                     rdfs:range <http://www.ub.bw/ontologies/arto#AgileArtefact> ;
                                                     
                                                     rdfs:domain <http://www.ub.bw/ontologies/arto#TraceLink> .



###  http://www.ub.bw/ontologies/arto#hasStory

<http://www.ub.bw/ontologies/arto#hasStory> rdf:type owl:AsymmetricProperty ,
                                                     owl:ObjectProperty ;
                                            
                                            rdfs:label "has story"@en ;
                                            
                                            rdfs:comment "Links an Epic to its constituent UserStories. TAWOS: Epic Story/Parent Feature (350 links). Asymmetric. Sits above hasImplementingTask: Epic → UserStory → SprintTask."@en ;
                                            
                                            rdfs:domain <http://www.ub.bw/ontologies/arto#Epic> ;
                                            
                                            rdfs:range <http://www.ub.bw/ontologies/arto#UserStory> ;
                                            
                                            rdfs:subPropertyOf <http://www.ub.bw/ontologies/arto#hasTraceLink> .



###  http://www.ub.bw/ontologies/arto#hasTargetArtefact

<http://www.ub.bw/ontologies/arto#hasTargetArtefact> rdf:type owl:FunctionalProperty ,
                                                              owl:ObjectProperty ;
                                                     
                                                     rdfs:label "has target artefact"@en ;
                                                     
                                                     rdfs:comment "The AgileArtefact to which this TraceLink points. Functional — each TraceLink has exactly one target."@en ;
                                                     
                                                     rdfs:range <http://www.ub.bw/ontologies/arto#AgileArtefact> ;
                                                     
                                                     rdfs:domain <http://www.ub.bw/ontologies/arto#TraceLink> .



###  http://www.ub.bw/ontologies/arto#hasTermVariant

<http://www.ub.bw/ontologies/arto#hasTermVariant> rdf:type owl:ObjectProperty ;
                                                  
                                                  rdfs:label "has term variant"@en ;
                                                  
                                                  rdfs:comment "Inverse of arto:refersToIssue. An AgileArtefact can have multiple TermVariant labels across projects."@en ;
                                                  
                                                  rdfs:domain <http://www.ub.bw/ontologies/arto#AgileArtefact> ;
                                                  
                                                  rdfs:range <http://www.ub.bw/ontologies/arto#TermVariant> ;
                                                  
                                                  owl:inverseOf <http://www.ub.bw/ontologies/arto#refersToIssue> .



###  http://www.ub.bw/ontologies/arto#hasTimeInterval

<http://www.ub.bw/ontologies/arto#hasTimeInterval> rdf:type owl:ObjectProperty ;
                                                   
                                                   rdfs:label "has time interval"@en ;
                                                   
                                                   rdfs:comment "Event ODP property. Links an Event to its time interval. Instantiated on Sprint in Step 5 with startDate and endDate data properties."@en ;
                                                   
                                                   rdfs:domain <http://www.ub.bw/ontologies/arto#Event> .



###  http://www.ub.bw/ontologies/arto#hasTraceLink

<http://www.ub.bw/ontologies/arto#hasTraceLink> rdf:type owl:ObjectProperty ;
                                                
                                                rdfs:label "has trace link"@en ;
                                                
                                                rdfs:comment "General trace link superproperty. All specific RT properties are SubPropertyOf hasTraceLink. Any artefact with no hasTraceLink assertion or inference is classified as OrphanArtefact by HermiT. Bridges M1 and M2 in the full ARTO network."@en ,
                                                             """S1 REUSE INTENT (not executed):
arto:hasTraceLink was designed to be conceptually equivalent
to the TraceLink concept in Pakdeetrakulwong et al. (2015) —
An Active Ontology-Based Requirements Traceability Approach.
International Journal of Software Engineering and Its
Applications. Vol 9(2).

The intended bridge axiom was:
  arto:TraceLink owl:equivalentClass pakdee:TraceLink

This could not be executed because the Pakdeetrakulwong
et al. (2015) ontology OWL file is not publicly available.
Same barrier as noted above (Martínez-García et al. 2022).

The intellectual alignment is preserved here via this
rdfs:comment annotation. ARTO's hasTraceLink superproperty
and TraceLink class (M2) serve the same role as
Pakdeetrakulwong's TraceLink concept — the formal
representation of a directed traceability connection
between two software artefacts."""@en ;
                                                
                                                rdfs:domain <http://www.ub.bw/ontologies/arto#AgileArtefact> ;
                                                
                                                rdfs:range <http://www.ub.bw/ontologies/arto#AgileArtefact> .



###  http://www.ub.bw/ontologies/arto#hasVariant

<http://www.ub.bw/ontologies/arto#hasVariant> rdf:type owl:ObjectProperty ;
                                              
                                              rdfs:label "has variant"@en ;
                                              
                                              rdfs:comment "Links a SynonymCluster to its constituent TermVariant individuals. One-to-many — a cluster contains at least 2 variants. Core M4 property enabling CQ8 synonym resolution."@en ;
                                              
                                              rdfs:domain <http://www.ub.bw/ontologies/arto#SynonymCluster> ;
                                              
                                              rdfs:range <http://www.ub.bw/ontologies/arto#TermVariant> .



###  http://www.ub.bw/ontologies/arto#impacts

<http://www.ub.bw/ontologies/arto#impacts> rdf:type owl:ObjectProperty ,
                                                    owl:TransitiveProperty ;
                                           
                                           rdfs:label "impacts"@en ;
                                           
                                           rdfs:comment "Transitive impact property inferred by SWRL Rule R1. If a UserStory has an implementing SprintTask that traces to a CodeCommit, then the UserStory impacts the CodeCommit. Transitive: if A impacts B and B impacts C then A impacts C. SubPropertyOf hasTraceLink — all inferred impact links count in CQ5 coverage queries. Not directly asserted in ETL — produced by HermiT SWRL reasoning."@en ;
                                           
                                           rdfs:domain <http://www.ub.bw/ontologies/arto#AgileArtefact> ;
                                           
                                           rdfs:range <http://www.ub.bw/ontologies/arto#AgileArtefact> ;
                                           
                                           rdfs:subPropertyOf <http://www.ub.bw/ontologies/arto#hasTraceLink> .



###  http://www.ub.bw/ontologies/arto#inBacklog

<http://www.ub.bw/ontologies/arto#inBacklog> rdf:type owl:ObjectProperty ;
                                             
                                             rdfs:label "in backlog"@en ;
                                             
                                             rdfs:comment "Inverse of arto:hasBacklogItem. Each BacklogItem belongs to one SprintBacklog."@en ;
                                             
                                             rdfs:domain <http://www.ub.bw/ontologies/arto#BacklogItem> ;
                                             
                                             rdfs:range <http://www.ub.bw/ontologies/arto#SprintBacklog> ;
                                             
                                             owl:inverseOf <http://www.ub.bw/ontologies/arto#hasBacklogItem> .



###  http://www.ub.bw/ontologies/arto#inCluster

<http://www.ub.bw/ontologies/arto#inCluster> rdf:type owl:FunctionalProperty ,
                                                      owl:ObjectProperty ;
                                             
                                             rdfs:label "in cluster"@en ;
                                             
                                             rdfs:comment "Inverse of arto:hasVariant. Each TermVariant belongs to exactly one SynonymCluster. Functional."@en ;
                                             
                                             rdfs:range <http://www.ub.bw/ontologies/arto#SynonymCluster> ;
                                             
                                             rdfs:domain <http://www.ub.bw/ontologies/arto#TermVariant> ;
                                             
                                             owl:inverseOf <http://www.ub.bw/ontologies/arto#hasVariant> .



###  http://www.ub.bw/ontologies/arto#isAddressedBy

<http://www.ub.bw/ontologies/arto#isAddressedBy> rdf:type owl:ObjectProperty ;
                                                 
                                                 rdfs:label "is addressed by"@en ;
                                                 
                                                 rdfs:comment "Inverse of arto:addresses. Inferred by HermiT — not asserted in ETL."@en ;
                                                 
                                                 rdfs:domain <http://www.ub.bw/ontologies/arto#AgileArtefact> ;
                                                 
                                                 rdfs:range <http://www.ub.bw/ontologies/arto#AgileArtefact> ;
                                                 
                                                 owl:inverseOf <http://www.ub.bw/ontologies/arto#addresses> .



###  http://www.ub.bw/ontologies/arto#isBacklogOf

<http://www.ub.bw/ontologies/arto#isBacklogOf> rdf:type owl:FunctionalProperty ,
                                                        owl:ObjectProperty ;
                                               
                                               rdfs:label "is backlog of"@en ;
                                               
                                               rdfs:comment "Inverse of arto:hasBacklog. Each SprintBacklog belongs to exactly one Sprint. Functional."@en ;
                                               
                                               rdfs:range <http://www.ub.bw/ontologies/arto#Sprint> ;
                                               
                                               rdfs:domain <http://www.ub.bw/ontologies/arto#SprintBacklog> ;
                                               
                                               owl:inverseOf <http://www.ub.bw/ontologies/arto#hasBacklog> .



###  http://www.ub.bw/ontologies/arto#isBlockedBy

<http://www.ub.bw/ontologies/arto#isBlockedBy> rdf:type owl:ObjectProperty ;
                                               
                                               rdfs:label "is blocked by"@en ;
                                               
                                               rdfs:comment "Inverse of arto:blocks. Inferred by HermiT — not asserted in ETL."@en ;
                                               
                                               rdfs:range <http://www.ub.bw/ontologies/arto#AgileArtefact> ;
                                               
                                               rdfs:domain <http://www.ub.bw/ontologies/arto#AgileArtefact> ;
                                               
                                               owl:inverseOf <http://www.ub.bw/ontologies/arto#blocks> .



###  http://www.ub.bw/ontologies/arto#isCausedBy

<http://www.ub.bw/ontologies/arto#isCausedBy> rdf:type owl:ObjectProperty ;
                                              
                                              rdfs:label "is caused by"@en ;
                                              
                                              rdfs:comment "Inverse of arto:causes. Inferred by HermiT — not asserted in ETL."@en ;
                                              
                                              rdfs:domain <http://www.ub.bw/ontologies/arto#AgileArtefact> ;
                                              
                                              rdfs:range <http://www.ub.bw/ontologies/arto#Bug> ;
                                              
                                              owl:inverseOf <http://www.ub.bw/ontologies/arto#causes> .



###  http://www.ub.bw/ontologies/arto#isDependedOnBy

<http://www.ub.bw/ontologies/arto#isDependedOnBy> rdf:type owl:ObjectProperty ;
                                                  
                                                  rdfs:label "is depended on by"@en ;
                                                  
                                                  rdfs:comment "Inverse of arto:dependsOn. Inferred by HermiT — not asserted in ETL."@en ;
                                                  
                                                  rdfs:domain <http://www.ub.bw/ontologies/arto#AgileArtefact> ;
                                                  
                                                  rdfs:range <http://www.ub.bw/ontologies/arto#AgileArtefact> ;
                                                  
                                                  owl:inverseOf <http://www.ub.bw/ontologies/arto#dependsOn> .



###  http://www.ub.bw/ontologies/arto#isDerivedFrom

<http://www.ub.bw/ontologies/arto#isDerivedFrom> rdf:type owl:ObjectProperty ;
                                                 
                                                 rdfs:label "is derived from"@en ;
                                                 
                                                 rdfs:comment "Inverse of arto:derives. Inferred by HermiT — not asserted in ETL."@en ;
                                                 
                                                 rdfs:domain <http://www.ub.bw/ontologies/arto#AgileArtefact> ;
                                                 
                                                 rdfs:range <http://www.ub.bw/ontologies/arto#AgileArtefact> ;
                                                 
                                                 owl:inverseOf <http://www.ub.bw/ontologies/arto#derives> .



###  http://www.ub.bw/ontologies/arto#isDocumentedBy

<http://www.ub.bw/ontologies/arto#isDocumentedBy> rdf:type owl:ObjectProperty ;
                                                  
                                                  rdfs:label "is documented by"@en ;
                                                  
                                                  rdfs:comment "Inverse of arto:documents. Inferred by HermiT — not asserted in ETL."@en ;
                                                  
                                                  rdfs:domain <http://www.ub.bw/ontologies/arto#AgileArtefact> ;
                                                  
                                                  rdfs:range <http://www.ub.bw/ontologies/arto#Documentation> ;
                                                  
                                                  owl:inverseOf <http://www.ub.bw/ontologies/arto#documents> .



###  http://www.ub.bw/ontologies/arto#isFixedBy

<http://www.ub.bw/ontologies/arto#isFixedBy> rdf:type owl:ObjectProperty ;
                                             
                                             rdfs:label "is fixed by"@en ;
                                             
                                             rdfs:comment "Inverse of arto:fixes. Inferred by HermiT — not asserted in ETL."@en ;
                                             
                                             rdfs:domain <http://www.ub.bw/ontologies/arto#Bug> ;
                                             
                                             rdfs:range <http://www.ub.bw/ontologies/arto#ImplementationArtefact> ;
                                             
                                             owl:inverseOf <http://www.ub.bw/ontologies/arto#fixes> .



###  http://www.ub.bw/ontologies/arto#isImpactedBy

<http://www.ub.bw/ontologies/arto#isImpactedBy> rdf:type owl:ObjectProperty ;
                                                
                                                rdfs:label "is impacted by"@en ;
                                                
                                                rdfs:comment "Inverse of arto:impacts. Inferred by HermiT."@en ;
                                                
                                                rdfs:domain <http://www.ub.bw/ontologies/arto#AgileArtefact> ;
                                                
                                                rdfs:range <http://www.ub.bw/ontologies/arto#AgileArtefact> ;
                                                
                                                owl:inverseOf <http://www.ub.bw/ontologies/arto#impacts> .



###  http://www.ub.bw/ontologies/arto#isImplementedBy

<http://www.ub.bw/ontologies/arto#isImplementedBy> rdf:type owl:AsymmetricProperty ,
                                                            owl:ObjectProperty ;
                                                   
                                                   rdfs:label "is implemented by"@en ;
                                                   
                                                   rdfs:comment "Inverse of arto:hasImplementingTask. A SprintTask implements at least one UserStory."@en ;
                                                   
                                                   rdfs:domain <http://www.ub.bw/ontologies/arto#SprintTask> ;
                                                   
                                                   rdfs:range <http://www.ub.bw/ontologies/arto#UserStory> ;
                                                   
                                                   owl:inverseOf <http://www.ub.bw/ontologies/arto#hasImplementingTask> .



###  http://www.ub.bw/ontologies/arto#isPartOf

<http://www.ub.bw/ontologies/arto#isPartOf> rdf:type owl:ObjectProperty ;
                                            
                                            rdfs:label "is part of"@en ;
                                            
                                            rdfs:comment "Inverse of arto:hasPart. Inferred by HermiT — not asserted in ETL."@en ;
                                            
                                            rdfs:domain <http://www.ub.bw/ontologies/arto#AgileArtefact> ;
                                            
                                            rdfs:range <http://www.ub.bw/ontologies/arto#AgileArtefact> ;
                                            
                                            owl:inverseOf <http://www.ub.bw/ontologies/arto#hasPart> .



###  http://www.ub.bw/ontologies/arto#isPrecededBy

<http://www.ub.bw/ontologies/arto#isPrecededBy> rdf:type owl:ObjectProperty ;
                                                
                                                rdfs:label "is preceded by"@en ;
                                                
                                                rdfs:comment "Inverse of arto:followsSprint. Inferred by HermiT — not asserted in ETL."@en ;
                                                
                                                rdfs:range <http://www.ub.bw/ontologies/arto#Sprint> ;
                                                
                                                rdfs:domain <http://www.ub.bw/ontologies/arto#Sprint> ;
                                                
                                                owl:inverseOf <http://www.ub.bw/ontologies/arto#followsSprint> .



